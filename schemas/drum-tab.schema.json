{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://got-feedback.github.io/feedpak-spec/schemas/drum-tab.schema.json",
  "$comment": "SPDX-License-Identifier: MIT. feedpak drum_tab.json (per-piece drum hits). See spec/feedpak-v1.md §7.5.",
  "title": "feedpak drum tab",
  "type": "object",
  "required": ["version", "hits"],
  "additionalProperties": true,
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "name": { "type": "string" },
    "kit": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id"],
        "additionalProperties": true,
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" }
        }
      }
    },
    "hits": { "type": "array", "items": { "$ref": "#/$defs/hit" } },
    "star_power": { "$ref": "#/$defs/ranges", "$comment": "Star-power phrases (1.20.0)." },
    "fills": { "$ref": "#/$defs/ranges", "$comment": "Fill / star-power activation phrases (1.20.0)." },
    "solos": { "$ref": "#/$defs/ranges", "$comment": "Drum-solo sections (1.20.0)." },
    "levels": {
      "type": "object",
      "$comment": "Easier difficulties (1.20.0). Closed id list easy/medium/hard; a Reader ignores any other id.",
      "additionalProperties": true,
      "properties": {
        "easy": { "$ref": "#/$defs/level" },
        "medium": { "$ref": "#/$defs/level" },
        "hard": { "$ref": "#/$defs/level" }
      }
    }
  },
  "$defs": {
    "hit": {
      "type": "object",
      "required": ["t", "p"],
      "additionalProperties": true,
      "properties": {
        "t": { "type": "number" },
        "p": { "type": "string" },
        "v": { "type": "integer", "minimum": 1, "maximum": 127 },
        "g": { "type": "boolean" },
        "f": { "type": "boolean" },
        "k": { "type": "number" },
        "a": { "type": "boolean", "$comment": "Accent (1.20.0)." },
        "x2": { "type": "boolean", "$comment": "Double-kick (Expert+) note (1.20.0); meaningful on kick in the top-level hits[] only." }
      },
      "not": {
        "$comment": "A hit is not both accented and ghosted (1.20.0).",
        "required": ["a", "g"],
        "properties": { "a": { "const": true }, "g": { "const": true } }
      }
    },
    "range": {
      "type": "object",
      "required": ["start_time", "end_time"],
      "additionalProperties": true,
      "properties": {
        "start_time": { "type": "number" },
        "end_time": { "type": "number" }
      }
    },
    "ranges": { "type": "array", "items": { "$ref": "#/$defs/range" } },
    "level": {
      "type": "object",
      "required": ["hits"],
      "additionalProperties": true,
      "properties": {
        "hits": { "type": "array", "items": { "$ref": "#/$defs/hit" } },
        "generated": { "type": "boolean" }
      }
    }
  }
}
